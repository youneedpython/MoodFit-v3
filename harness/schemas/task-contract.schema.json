{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "task_file",
    "allowed_paths",
    "forbidden_paths",
    "max_review_cycles",
    "verify"
  ],
  "properties": {
    "agents_sections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-9]\\d*(?:\\.\\d+)*$" }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "task_file": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "max_review_cycles": {
      "type": "number",
      "const": 3
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "cwd"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
