{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryAuthentication",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublishImmutableImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:DescribeImages"
      ],
      "Resource": "${StagingRepositoryArn}"
    },
    {
      "Sid": "ReadService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices"
      ],
      "Resource": "${StagingServiceArn}"
    },
    {
      "Sid": "UpdateApprovedService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService"
      ],
      "Resource": "${StagingServiceArn}",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "${StagingClusterArn}"
        },
        "ArnLike": {
          "ecs:task-definition": "${StagingTaskDefinitionArnPattern}"
        }
      }
    },
    {
      "Sid": "PublishStaticObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "${StagingStaticObjectArn}"
    },
    {
      "Sid": "ListStaticBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "${StagingStaticBucketArn}"
    },
    {
      "Sid": "InvalidateStaticCache",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "${StagingDistributionArn}"
    },
    {
      "Sid": "IdentifySession",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectAppStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:ListChangeSets",
        "cloudformation:DescribeChangeSet"
      ],
      "Resource": "${StagingAppStackArn}"
    },
    {
      "Sid": "PrepareAppChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "${StagingAppStackArn}",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "${StagingAppChangeSetRoleArn}"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::ECS::Service",
            "AWS::ECS::TaskDefinition"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false"
        }
      }
    },
    {
      "Sid": "ExecuteAppChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet"
      ],
      "Resource": "${StagingAppStackArn}"
    },
    {
      "Sid": "PassAppChangeSetRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "${StagingAppChangeSetRoleArn}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
