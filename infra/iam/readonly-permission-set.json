{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifySession",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectStagingChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListStackResources",
        "cloudformation:ListChangeSets",
        "cloudformation:DescribeChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:${AccountId}:stack/moodfit-staging-*/*",
        "arn:aws:cloudformation:us-east-1:${AccountId}:stack/moodfit-staging-certificate/*"
      ]
    },
    {
      "Sid": "InspectTargetHealth",
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:DescribeTargetHealth"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-northeast-2"}}
    },
    {
      "Sid": "InspectStagingService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices"
      ],
      "Resource": "${StagingServiceArn}"
    },
    {
      "Sid": "InspectImage",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages"
      ],
      "Resource": "${RepositoryArn}"
    }
  ]
}
