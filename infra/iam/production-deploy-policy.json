{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegisterEnvironmentTaskRevision",
      "Effect": "Allow",
      "Action": ["ecs:RegisterTaskDefinition"],
      "Resource": "${ProductionTaskDefinitionArnPattern}",
      "Condition": {"StringEquals": {"aws:RequestTag/MoodFitEnvironment": "production"}}
    },
    {
      "Sid": "TagNewTaskRevision",
      "Effect": "Allow",
      "Action": ["ecs:TagResource"],
      "Resource": "${ProductionTaskDefinitionArnPattern}",
      "Condition": {"StringEquals": {"ecs:CreateAction": "RegisterTaskDefinition"}}
    },
    {
      "Sid": "InspectTaskRevision",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "RegistryAuthentication",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublishImmutableImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:DescribeImages"
      ],
      "Resource": "${ProductionRepositoryArn}"
    },
    {
      "Sid": "ReadService",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices"
      ],
      "Resource": "${ProductionServiceArn}"
    },
    {
      "Sid": "UpdateApprovedService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService"
      ],
      "Resource": "${ProductionServiceArn}",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "${ProductionClusterArn}"
        },
        "ArnLike": {
          "ecs:task-definition": "${ProductionTaskDefinitionArnPattern}"
        }
      }
    },
    {
      "Sid": "PassRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "${ProductionExecutionRoleArn}",
        "${ProductionTaskRoleArn}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PublishStaticObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "${ProductionStaticObjectArn}"
    },
    {
      "Sid": "ListStaticBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "${ProductionStaticBucketArn}"
    },
    {
      "Sid": "InvalidateStaticCache",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "${ProductionDistributionArn}"
    }
  ]
}
